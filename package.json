{
  "name": "orbita",
  "version": "1.0.32",
  "description": "Orbita Android Messenger",
  "author": "Saizzi",
  "main": "index.js",
  "scripts": {
    "dev": "vite",
    "build": "npx -p typescript tsc --noEmit && vite build",
    "build:web": "vite build",
    "sync:assets": "powershell -Command \"New-Item -ItemType Directory -Force -Path 'android/app/src/main/assets/web' | Out-Null; Copy-Item -Recurse -Force 'dist/*' 'android/app/src/main/assets/web'\"",
    "expo:prebuild": "npx expo prebuild --platform android",
    "android:build": "npm run build:web && npm run sync:assets && powershell -Command \"Set-Item -Path Env:JAVA_HOME -Value 'C:\\Program Files\\Android\\Android Studio\\jbr'; Set-Item -Path Env:ANDROID_HOME -Value '$env:LOCALAPPDATA\\Android\\Sdk'; cd android; .\\gradlew.bat assembleDebug\"",
    "android:install": "adb install -r android/app/build/outputs/apk/debug/app-debug.apk",
    "android:run": "npm run android:build && npm run android:install && adb shell monkey -p com.saizzi.orbita -c android.intent.category.LAUNCHER 1",
    "backup": "node scripts/backup.js"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@gravity-ui/icons": "^2.21.0",
    "@mui/material": "^9.0.0",
    "@noble/curves": "^2.4.0",
    "@privacyresearch/libsignal-protocol-typescript": "^0.0.16",
    "@stablelib/hex": "^1.0.1",
    "@stablelib/hkdf": "^1.0.1",
    "@stablelib/random": "^1.0.2",
    "@stablelib/sha256": "^1.0.1",
    "@stablelib/x25519": "^1.0.1",
    "@supabase/supabase-js": "^2.117.2",
    "@tailwindcss/vite": "^4.2.4",
    "ably": "^2.21.0",
    "cors": "^2.8.6",
    "crypto-js": "^4.2.0",
    "dotenv": "^17.4.2",
    "expo": "^57.0.26",
    "expo-status-bar": "^57.0.1",
    "express": "^5.2.1",
    "framer-motion": "^12.38.0",
    "fs-extra": "^11.0.0",
    "i18next": "^23.16.8",
    "i18next-browser-languagedetector": "^7.2.2",
    "jsmediatags": "^3.9.7",
    "jsqr": "^1.4.0",
    "livekit-client": "^2.20.1",
    "livekit-server-sdk": "^2.17.0",
    "lottie-react": "^2.4.1",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.14.0",
    "music-metadata": "^10.0.0",
    "nanoid": "^5.1.11",
    "purify-voice": "^1.0.9",
    "pusher": "^5.3.4",
    "pusher-js": "^8.5.0",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-i18next": "^14.1.3",
    "react-native": "^0.86.3",
    "react-native-webview": "^14.0.1",
    "react-virtuoso": "^4.18.11",
    "ws": "^8.21.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@types/crypto-js": "^4.2.2",
    "@types/jsmediatags": "^3.9.6",
    "@types/node": "^22.19.20",
    "@types/pusher-js": "^4.2.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "autoprefixer": "^10.5.0",
    "postcss": "^8.5.13",
    "tailwindcss": "^4.2.4",
    "typescript": "~5.8.3",
    "vite": "^7.0.4",
    "wrangler": "^4.112.0"
  }
}
